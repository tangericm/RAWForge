<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Nothing leaves the device. There is no network code, no analytics, no
	     third-party SDK, and no account. Sessions move by Files or a cable
	     (#11), which is a user action rather than something the app does. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>

	<!-- Declared because the code calls it, and only what the code calls.
	     An over-broad manifest invites questions it cannot answer. -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!-- SessionStore.availableCapacityBytes reads
			     volumeAvailableCapacityKey, to refuse a station that would
			     not fit rather than abort it halfway through. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryDiskSpace</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>E174.1</string>
			</array>
		</dict>
		<dict>
			<!-- Capture and diagnostic clocks read systemUptime only to derive
			     segment-relative elapsed values. Raw boot time is never stored
			     or exported. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategorySystemBootTime</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>35F9.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
